  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Canvas Controller – invisible plane, band maths, placement</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float canvasWidthCm = 56 {"hint":"Canvas width in centimetres. Sized to fit the Specs display: the usable area is about 53x77cm at 110cm, so at the default 150cm placement roughly 72cm wide fits edge to edge.", "widget":"slider", "min":30, "max":100, "step":1}'
    - "// @input float bandHeightCm = 28 {\"hint\":\"Height of ONE player's band in centimetres. Total canvas height is this times the player count. Three bands at 32cm fit the display with margin to spare.\", \"widget\":\"slider\", \"min\":15, \"max\":60, \"step\":1}"
    - '// @input float seamCm = 3.5 {"hint":"How much of the band above is visible as the seam, in centimetres. A narrow splice is the whole point of the game — the less you see, the funnier the reveal.", "widget":"slider", "min":0.5, "max":25, "step":0.5}'
    - '// @input float placementDistanceCm = 150 {"hint":"Closest the canvas will ever be placed, in centimetres.", "widget":"slider", "min":60, "max":400, "step":5}'
    - '// @input float bandViewingRatio = 4 {"hint":"Distance is set so ONE band is comfortable to draw in, as a multiple of band height. The whole canvas need not fit in view.", "widget":"slider", "min":2, "max":8, "step":0.1}'
    - '// @input float topAboveEyeCm = 48 {"hint":"How far the TOP of the canvas sits above eye level, in centimetres. At the default a three-band canvas centres on the eye line and fits the display; taller canvases anchor their top here instead of towering overhead.", "widget":"slider", "min":0, "max":120, "step":2}'
    - '// @ui {"widget":"group_end"}'
