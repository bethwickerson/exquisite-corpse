  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Pass UI – hand-over screen and READY dwell zone</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float panelWidthCm = 62 {"hint":"Panel width in centimetres.", "widget":"slider", "min":24, "max":80, "step":1}'
