  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">HUD Rail – vertical DONE / player / UNDO beside the canvas</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float panelHeightCm = 34 {"hint":"Rail height in centimetres.", "widget":"slider", "min":14, "max":60, "step":0.5}'
    - '// @input float buttonSizeCm = 6 {"hint":"Diameter of the round DONE and UNDO buttons, in centimetres. Below about 6cm at this distance they fall under the gaze-dwell target minimum.", "widget":"slider", "min":4, "max":16, "step":0.5}'
    - '// @input float extraWidthCm = 0.1 {"hint":"Space added around the controls to make the plate, in centimetres. This is the direct width control: the rail is always the widest control plus this, so it can never end up too narrow to hold its contents. Negative pulls the plate in tighter than the buttons.", "widget":"slider", "min":-2, "max":8, "step":0.1}'
    - '// @input float iconScale = 1.15 {"hint":"Multiplier on the icon inside each button. Above 1 makes the glyph fill more of the circle.", "widget":"slider", "min":0.5, "max":2, "step":0.05}'
    - '// @input float playerGapCm = 1.6 {"hint":"Extra space below the player row, in centimetres. Pushes the buttons down clear of the prompt line.", "widget":"slider", "min":0, "max":8, "step":0.1}'
    - '// @input float playerIconCm = 4 {"hint":"Size of the player-count icon in centimetres.", "widget":"slider", "min":2, "max":10, "step":0.5}'
    - '// @input float playerNumberScale = 0.55 {"hint":"Size of the player number beside the head icon, relative to the read distance.", "widget":"slider", "min":0.25, "max":1.5, "step":0.05}'
    - '// @input float readDistanceCm = 150 {"hint":"Distance from the viewer in centimetres. Scales text on this rail.", "widget":"slider", "min":50, "max":250, "step":5}'
    - '// @input vec4 accentColor = "{1.0, 1.0, 1.0, 1.0}" {"hint":"Outline colour of the UNDO circle.", "widget":"color"}'
    - "// @input float panelOpacity = 0.65 {\"hint\":\"Opacity of the rail's backing plate. Specs is additive, so a solid plate ADDS light. Keep low, or zero for no plate at all.\", \"widget\":\"slider\", \"min\":0, \"max\":1, \"step\":0.05}"
    - '// @ui {"widget":"group_end"}'
